# ============================================================================
# Supabase Configuration
# ============================================================================
# Get these from: Supabase Dashboard > Project Settings > API > URL & Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================================
# Database Configuration
# ============================================================================
# Get this from: Supabase Dashboard > Database > Connection Pooling > PostgreSQL
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# ============================================================================
# WhatsApp Configuration
# ============================================================================
# Get these from: Meta Business Platform > Your App > WhatsApp > Settings
WHATSAPP_ACCESS_TOKEN=your-access-token-here
WHATSAPP_VERIFY_TOKEN=ShopBrain_kigali_2026

# ============================================================================
# Application Settings (Optional)
# ============================================================================
# Log level: debug, info, warn, error
LOG_LEVEL=info

# Node environment: production, development
NODE_ENV=production

# Port (default: 3000, can be overridden by docker-compose)
PORT=3000
